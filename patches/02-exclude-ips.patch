+	# If the default gateway changed, re-point the ExcludeIPs bypass routes at it.
+	if [[ $remove_all_old -eq 1 && ${#EXCLUDED_IPS[@]} -gt 0 ]]; then
+		del_excluded_routes
+		add_excluded_routes
+	fi
 }
 
