 # tunnel via the real default gateway, so traffic to them bypasses the VPN.
 # AllowedIPs is left untouched (typically 0.0.0.0/0) - this is a routing-level split.
 add_excluded_routes() {
-	local ip
-	[[ ${#EXCLUDED_IPS[@]} -gt 0 ]] || return 0
+	local ip family gateway
+	[[ $TABLE != off && ${#EXCLUDED_IPS[@]} -gt 0 ]] || return 0
 	[[ -n $GATEWAY4 || -n $GATEWAY6 ]] || collect_gateways
 	for ip in "${EXCLUDED_IPS[@]}"; do
+		[[ " ${EXCLUDED_ROUTES_ADDED[*]} " == *" $ip "* ]] && continue
+		family=inet; gateway="$GATEWAY4"
 		if [[ $ip == *:* ]]; then
-			[[ -n $GATEWAY6 ]] && cmd route -q -n add -inet6 "$ip" -gateway "$GATEWAY6" >/dev/null 2>&1 || true
+			family=inet6; gateway="$GATEWAY6"
+		fi
+		if [[ -z $gateway ]]; then
+			echo "Warning: no $family gateway; ExcludeIPs route for $ip was not added" >&2
+			continue
+		fi
+		if cmd route -q -n add -$family "$ip" -gateway "$gateway" >/dev/null; then
+			EXCLUDED_ROUTES_ADDED+=( "$ip" )
 		else
-			[[ -n $GATEWAY4 ]] && cmd route -q -n add -inet "$ip" -gateway "$GATEWAY4" >/dev/null 2>&1 || true
-		fi
-	done
+			echo "Warning: ExcludeIPs route for $ip was not added; existing routes are left unchanged" >&2
+		fi
+	done
+	return 0
 }
 
 del_excluded_routes() {
 	local ip family
-	for ip in "${EXCLUDED_IPS[@]}"; do
+	for ip in "${EXCLUDED_ROUTES_ADDED[@]}"; do
 		family=inet; [[ $ip == *:* ]] && family=inet6
-		cmd route -q -n delete -$family "$ip" >/dev/null 2>&1 || true
-	done
+		cmd route -q -n delete -$family "$ip" >/dev/null || true
+	done
+	EXCLUDED_ROUTES_ADDED=( )
 }
 
